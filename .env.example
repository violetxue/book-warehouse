# ===== 服务配置 =====
# 监听地址：0.0.0.0 允许局域网/公网访问（手机浏览器可直接打开）
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ===== 数据库（PostgreSQL）=====
# 示例：postgres://用户名:密码@主机:端口/数据库名
# 独立部署需先创建数据库并执行 npm run db:init 建表
DATABASE_URL=postgres://postgres:postgres@localhost:5432/book_warehouse

# ===== 文件存储 =====
# 上传文件保存目录（相对项目根，或绝对路径）
UPLOAD_DIR=data/uploads

# ===== 访问控制（可选）=====
# 默认免登录、任何人可访问。若需给写操作加口令：
# 设置 ADMIN_TOKEN 后，上传/删除/改名/排序等写操作需携带请求头 x-auth-token: <该值>
# ADMIN_TOKEN=

# ===== 日志 =====
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
